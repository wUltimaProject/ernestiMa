# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ucp_estimation
# For local development with SQLite, use:
# DATABASE_URL=sqlite:///./ucp_estimation.db

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3002,http://localhost:3000

# Frontend URL (for production)
FRONTEND_URL=https://your-app.vercel.app

# Vercel automatically sets VERCEL_URL, no need to set it manually

